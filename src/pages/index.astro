---
import Ocean from "../components/Ocean.astro";
import Section from "../components/Section.astro";
import { profile, education, experience, research } from "../data/profile";

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.bio.join(" ")} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400&family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Ocean />

    <main>
      <header>
        <h1>{profile.name}</h1>
        <p class="role">
          <span class="typed">{profile.role}<span class="sep">/</span>{profile.location}</span><span
            class="cursor"
            aria-hidden="true"></span>
        </p>
        <div class="bio">{profile.bio.map((p) => <p>{p}</p>)}</div>
        <nav aria-label="Links">
          {profile.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </header>

      <Section title="Education" entries={education} />
      <Section title="Experience" entries={experience} />
      <Section title="Research" entries={research} />

      <footer>
        <span>© {year} {profile.name}</span>
      </footer>
    </main>

    <script>
      // Typewriter for the role line. The full text ships in the HTML (SEO, screen
      // readers, no-JS); we only blank it out and retype it when motion is allowed.
      const el = document.querySelector<HTMLElement>(".role .typed");
      if (el && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        el.setAttribute("aria-label", el.textContent ?? "");
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        const nodes: { node: Text; text: string }[] = [];
        while (walker.nextNode()) {
          const node = walker.currentNode as Text;
          nodes.push({ node, text: node.data });
          node.data = "";
        }
        const total = nodes.reduce((sum, x) => sum + x.text.length, 0);
        // Show the first k characters, spread across the original text nodes.
        const show = (k: number) => {
          for (const x of nodes) {
            x.node.data = x.text.slice(0, Math.max(0, k));
            k -= x.text.length;
          }
        };

        // Loop: type → pause (cursor blinks) → delete → short pause → type again.
        let k = 0;
        let deleting = false;
        const tick = () => {
          el.classList.add("typing");
          if (!deleting) {
            show(++k);
            if (k < total) return setTimeout(tick, 45 + Math.random() * 45);
            deleting = true;
            el.classList.remove("typing");
            return setTimeout(tick, 2800);
          }
          show(--k);
          if (k > 0) return setTimeout(tick, 22 + Math.random() * 14);
          deleting = false;
          el.classList.remove("typing");
          return setTimeout(tick, 700);
        };
        setTimeout(tick, 500);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* --paper must match the ocean canvas background (#000) so the fade is seamless. */
    --paper: #000;
    --ink: #ededed;
    --body: #c4c4c8;
    --muted: #9b9ba1;
    --faint: #66666c;
    --rule: #1d1d20;
    --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-display: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  body {
    margin: 0;
  }
  html {
    color-scheme: dark;
  }
  ::selection {
    background: #2a3550;
    color: #fff;
  }
  a {
    color: inherit;
  }
</style>

<style>
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    position: relative;
    margin-top: -4.5rem;
  }
  header {
    padding-bottom: 3rem;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .role {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .sep {
    margin: 0 0.6em;
    color: var(--faint);
  }
  /* Hide the separator's margins while it hasn't been typed yet. */
  .sep:empty {
    margin: 0;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.2em;
    vertical-align: -0.2em;
    background: var(--muted);
    animation: blink 1.1s steps(1) infinite;
  }
  /* Solid while typing/deleting, blinking during pauses. */
  .typing + .cursor {
    animation: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  .bio {
    margin: 1.75rem 0 0;
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--body);
  }
  .bio p {
    margin: 0;
  }
  .bio p + p {
    margin-top: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.75rem;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  nav a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  footer a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  footer a:hover {
    color: var(--ink);
  }
</style>
